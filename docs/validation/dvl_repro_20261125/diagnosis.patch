+"""Causal formal-maintenance review, independent of AI evidence used by FTC.
+
+The existing evidence qualifier is shared with the batch policy. A bounded
+online state tracks confirmation and recovery; parity with the batch policy is
+checked on identical observation streams. No truth or future sample is read.
+"""
+from collections import deque
+from collections.abc import Mapping
+from copy import deepcopy
+import numpy as np
+from diagnosis.maintenance_ticket_policy import MaintenanceTicketConfig,_qualify_windows,_group_and_candidates
+from diagnosis.thruster_health_monitor import extract_thruster_health_features,resolve_generalized_mass_diagonal
+from ftc.safety_supervisor import build_rule_based_ftc_evidence, FTCSupervisorConfig
+
+
+def _telemetry_proof(log):
+    """Fresh joint current/RPM proof; missing/malformed packets fail closed."""
+    fields=("commanded_thruster_forces","thruster_force_limits","thruster_expected_currents",
+        "thruster_measured_currents","thruster_expected_rpms","thruster_measured_rpms",
+        "thruster_telemetry_valid","thruster_telemetry_age_s")
+    try:
+        values={k:np.asarray(log[k],dtype=float) for k in fields}
+        if any(a.shape!=(6,) or not np.all(np.isfinite(a)) for a in values.values()):
+            raise ValueError("Invalid packet")
+        if np.any(values["thruster_force_limits"]<=0.) or np.any(values["thruster_telemetry_age_s"]<0.):
+            raise ValueError("Invalid limits or age")
+        fresh=(values["thruster_telemetry_valid"]==1.) & (values["thruster_telemetry_age_s"]<=.20)
+        supplied=log.get("maintenance_no_output_scores")
+        if supplied is not None:
+            scores=np.asarray(supplied,dtype=float)
+            if (scores.shape!=(6,) or not np.all(np.isfinite(scores)) or np.any(scores<0.)
+                    or np.any(scores>1.) or abs(float(log["maintenance_no_output_evidence_time_s"])-float(log["time"]))>1e-9):
+                raise ValueError("Invalid same-step proof")
+        else:
+            scores=build_rule_based_ftc_evidence(log,config=FTCSupervisorConfig()).no_output_scores
+        return np.where(fresh,scores,0.),fresh
+    except (KeyError,TypeError,ValueError):
+        return np.zeros(6),np.zeros(6,dtype=bool)
+
+
+def _electrical_observations(log,fresh):
+    """Keep observable electrical alerts without claiming a mechanical cause."""
+    observations=[]
+    for field,kind,threshold in (("thruster_measured_voltages","undervoltage",.85*float(log.get("thruster_nominal_voltage",48.))),
+            ("thruster_measured_temperatures","overtemperature",float(log.get("thruster_ambient_temperature",20.))+45.)):
+        try: values=np.asarray(log[field],dtype=float)
+        except (KeyError,TypeError,ValueError):continue
+        if values.shape!=(6,):continue
+        anomaly=values<threshold if kind=="undervoltage" else values>threshold
+        for i in np.flatnonzero(fresh & np.isfinite(values) & anomaly):
+            observations.append(dict(thruster=("H1","H2","H3","H4","V1","V2")[i],kind=kind,
+                measured_value=float(values[i]),threshold=float(threshold),requires_inspection=True,
+                mechanical_no_output_confirmed=False))
+    return observations
+
+
+def _motion_sample_support(log,previous,maximum_gap_s):
+    """Integrity of body acceleration and rate derivative, NOT absolute XY."""
+    reasons=[]
+    if previous is None:return False,["no_previous_imu_sample"]
+    dt=float(log["time"])-float(previous["time"])
+    if not 0.<dt<=maximum_gap_s+1e-9:reasons.append("imu_sample_gap")
+    for packet,label,fields in ((log,"current",("linear_acceleration","angular_velocity")),
+            (previous,"previous",("angular_velocity",))):
+        imu=packet.get("imu",{})
+        if not isinstance(imu,Mapping):reasons.append(label+"_imu_missing");continue
+        validity=imu.get("valid",True)
+        if not isinstance(validity,(bool,np.bool_)) or not bool(validity):reasons.append(label+"_imu_invalid")
+        if imu.get("frame","body")!="body":reasons.append(label+"_imu_frame")
+        for field in fields:
+            try:a=np.asarray(imu[field],dtype=float)
+            except (KeyError,TypeError,ValueError):a=np.array([])
+            if a.shape!=(3,) or not np.all(np.isfinite(a)):reasons.append(label+"_imu_"+field+"_invalid")
+        health=packet.get("sensor_health",{}).get("imu",{})
+        if health.get("trust_level","trusted")!="trusted":reasons.append(label+"_imu_not_trusted")
+        source=packet.get("state_estimate_sources",{}).get("angular_velocity")
+        if source is not None and source!="imu":reasons.append(label+"_angular_rate_fallback")
+    return not reasons,reasons
+
+
+class OnlineMaintenanceReview:
+    def __init__(self,config=None,*,generalized_mass_diagonal=None,sequence_length=50,maximum_result_age_s=.6):
+        self.config=config or MaintenanceTicketConfig()
+        self.mass=resolve_generalized_mass_diagonal(generalized_mass_diagonal)
+        self.sequence_length=int(sequence_length)
+        self.maximum_result_age_s=float(maximum_result_age_s)
+        if self.sequence_length<2 or not np.isfinite(self.maximum_result_age_s) or self.maximum_result_age_s<=0:
+            raise ValueError("Invalid review window or result age")
+        self.reset()
+
+    def reset(self):
+        self.previous_log=None
+        self.tail=deque(maxlen=self.config.evidence_tail_steps)
+        self.contexts=deque(maxlen=self.sequence_length)
+        self.rows=[];self.last_inference=None;self.last_time=None
+        self.last_active=False;self.created_count=0;self.closed_count=0;self.events=[]
+        self.last_status=dict(active=False,pending=False,created=False,closed=False,qualified=False,
+            mode="normal",status="observing",inspection_candidates=[],
+            minimum_probability=self.config.minimum_current_mode_probability,
+            affects_ftc=False,created_count=0,closed_count=0)
+        self.last_usable=False
+        self.active_mode=0;self.pending_state=None;self.recovery_start=None
+        self.previous_context=None;self.location_sum=np.zeros(6);self.location_count=0
+
+    def _advance(self,row):
+        decisions=dict(health_level_pred=[row["level"]],mode_pred=[row["mode"]],
+            temporal_state_pred=[row["state"]],mode_probabilities=np.array([row["prob"]]),
+            smoothed_location_probabilities=np.array([row["location"]]),candidate_indices=np.array([row["candidates"]]))
+        evidence=dict(excitation_ratios=np.array([row["excitation"]]),
+            local_anomaly_scores=np.array([row["local"]]),motion_loss_evidence=np.array([row["motion"]]),
+            no_output_scores=np.array([row.get("no_output",np.zeros(6))]))
+        evidence["motion_evidence_valid"]=np.array([row.get("motion_valid",np.ones(6,dtype=bool))])
+        raw,mode,_,_=_qualify_windows(decisions,evidence,self.config)
+        raw=bool(raw[0]);mode=int(mode[0]);qualified=raw and (mode!=2 or row["stable"])
+        t=row["time"];context=row["context"];pending=self.pending_state
+        if self.previous_context is not None and context!=self.previous_context and pending is not None and pending["mode"]==2:
+            pending=None
+        self.previous_context=context
+        if pending is not None and pending["mode"]==2 and qualified and mode==2 and row["group"] in ("horizontal","vertical") and pending["group"] in ("horizontal","vertical") and row["group"]!=pending["group"]:
+            pending=None
+        if self.last_active:
+            if raw:
+                self.recovery_start=None
+                if mode==1:self.active_mode=1
+            else:
+                if self.recovery_start is None:self.recovery_start=t
+                if t-self.recovery_start>=self.config.ticket_recovery_s:
+                    self.active_mode=0;self.recovery_start=None
+            self.pending_state=pending
+            return self.active_mode>0,False,qualified,self.active_mode
+        if pending is not None and pending["mode"]==2 and raw and mode==1:pending=None
+        if pending is not None and pending["mode"]==2:
+            if qualified and mode==2:
+                if pending["previous_qualified"]:pending["duration"]+=max(0.,t-pending["last_time"])
+                pending.update(previous_qualified=True,last_time=t,recovery=None)
+                if pending["duration"]>=self.config.thrust_loss_pending_confirmation_s:
+                    self.active_mode=2;pending=None
+            else:
+                pending.update(previous_qualified=False,last_time=t)
+                if pending["recovery"] is None:pending["recovery"]=t
+                if t-pending["recovery"]>=self.config.thrust_loss_recovery_cancel_s:pending=None
+            if self.active_mode or pending is not None:
+                self.pending_state=pending
+                return self.active_mode>0,pending is not None,qualified,self.active_mode
+        if pending is not None and pending["mode"]==1:
+            if raw and mode==1:
+                if t-pending["start"]>=self.config.ticket_confirmation_s:self.active_mode=1;pending=None
+            else:pending=None
+            if self.active_mode or pending is not None:
+                self.pending_state=pending
+                return self.active_mode>0,pending is not None,qualified,self.active_mode
+        if raw and mode==1:
+            pending=dict(mode=1,start=t)
+            if self.config.ticket_confirmation_s<=0:self.active_mode=1;pending=None
+        elif qualified and mode==2:
+            pending=dict(mode=2,start=t,duration=0.,last_time=t,previous_qualified=True,recovery=None,group=row["group"])
+            if self.config.thrust_loss_pending_confirmation_s<=0:self.active_mode=2;pending=None
+        self.pending_state=pending
+        return self.active_mode>0,pending is not None,qualified,self.active_mode
+
+    @staticmethod
+    def _probability(values,size,default):
+        try: a=np.asarray(values,dtype=float)
+        except (TypeError,ValueError):return np.asarray(default,dtype=float)
+        if a.shape!=(size,) or not np.all(np.isfinite(a)) or np.any(a<0) or a.sum()<=0:
+            return np.asarray(default,dtype=float)
+        return a/a.sum()
+
+    def update(self,log,diagnosis):
+        time=float(log["time"])
+        if not np.isfinite(time) or (self.last_time is not None and time<=self.last_time):
+            raise ValueError("Review times must be finite and strictly increasing")
+        self.last_time=time
+        context=int(log.get("guidance_context_id",0))
+        self.contexts.append(context)
+        health=extract_thruster_health_features(log,self.previous_log,generalized_mass_diagonal=self.mass)
+        motion_valid,motion_reasons=_motion_sample_support(log,self.previous_log,self.config.maximum_motion_sample_gap_s)
+        self.previous_log=log
+        commands=np.asarray(log.get("commanded_thruster_forces",np.zeros(6)),dtype=float)
+        limits=np.asarray(log.get("thruster_force_limits",np.ones(6)*40),dtype=float)
+        no_output,fresh_telemetry=_telemetry_proof(log)
+        electrical=_electrical_observations(log,fresh_telemetry)
+        self.tail.append((commands.copy(),health.local_anomaly_score.copy(),health.motion_loss_evidence.copy(),no_output.copy(),time,motion_valid))
+        tail_motion_valid=all(r[5] and time-r[4]<=self.config.maximum_motion_evidence_age_s+1e-9 for r in self.tail)
+        if motion_valid and not tail_motion_valid:motion_reasons=["awaiting_clean_motion_evidence_tail"]
+        trusted=not any(state.get("trust_level")=="untrusted" for state in log.get("sensor_health",{}).values())
+        trusted=trusted and not log.get("ftc_untrusted_esc_channels",())
+        inference=diagnosis.get("inference_time_s")
+        try: age=time-float(inference)
+        except (TypeError,ValueError): age=float("inf")
+        usable=bool(diagnosis.get("available",False) and not diagnosis.get("advisory_gate_active",False)
+            and trusted and np.isfinite(age) and -1e-9<=age<=self.maximum_result_age_s+1e-9)
+        fresh=bool(diagnosis.get("updated",False) and inference is not None and
+            (self.last_inference is None or float(inference)>self.last_inference))
+        context_changed=bool(self.rows and context!=self.rows[-1]["context"])
+        invalid_due=not usable and (not self.rows or self.last_usable or context_changed or time-self.rows[-1]["time"]>=.5-1e-9)
+        self.last_usable=usable
+        status=dict(self.last_status,created=False,closed=False,updated=False,
+            time_s=time,model_available=usable,raw_event_retained=bool(diagnosis.get("record_event",False)
+                or diagnosis.get("raw_health_level",0)>0 or electrical),current_fault_probability=None,
+            electrical_observations=electrical,no_output_evidence_available=bool(np.any(fresh_telemetry)),
+            current_no_output_scores=no_output.tolist(),
+            evidence_policy="fresh_joint_current_rpm_and_valid_body_motion_v2",
+            motion_evidence_available=tail_motion_valid,motion_evidence_reasons=motion_reasons,
+            motion_evidence_source="body_imu_acceleration_and_rate_derivative",
+            navigation_reference_warning=(log.get("horizontal_position_reference")=="degraded_without_absolute_fix"))
+        if not (fresh or invalid_due):
+            return status
+        if fresh:self.last_inference=float(inference)
+        prob=self._probability(diagnosis.get("raw_mode_probabilities"),3,[1.,0.,0.]) if usable else np.array([1.,0.,0.])
+        location=self._probability(diagnosis.get("raw_location_probabilities"),6,[1/6]*6)
+        tail=list(self.tail)
+        excitation=np.sqrt(np.mean([r[0]**2 for r in tail],axis=0))/np.maximum(limits,1e-6)
+        candidates=[int(c.get("index",0)) for c in diagnosis.get("candidates",[])][:2]
+        candidates=(candidates+[0,0])[:2]
+        stable=len(self.contexts)==self.sequence_length and all(c==context for c in self.contexts)
+        recent_proof=[r[3] for r in tail if time-r[4]<=self.config.maximum_no_output_evidence_age_s+1e-9]
+        self.rows.append(dict(time=time,context=context,stable=stable,
+            level=int(diagnosis.get("health_level",0)) if usable else 0,
+            mode=int(diagnosis.get("confirmed_mode",0)) if usable else 0,
+            state=str(diagnosis.get("temporal_state","normal")) if usable else "normal",
+            group=str(diagnosis.get("suspected_group","none")),prob=prob,location=location,
+            candidates=candidates,excitation=np.clip(excitation,0,1),
+            local=np.mean([r[1] for r in tail],axis=0),motion=np.mean([r[2] for r in tail],axis=0),
