+"""Finite navigation pause, guarded powered abort, and external re-anchoring.
+
+No plant truth, fault schedule, automatic mission resume, emergency ballast,
+surface hydrodynamics or acoustic/GNSS receiver is implemented here. A mission
+must explicitly authorize a clear ascent corridor. Default policy refuses it.
+"""
+from dataclasses import dataclass
+import numpy as np
+
+
+@dataclass(frozen=True)
+class RecoveryConfig:
+    pause_timeout_s: float = 20.0
+    ascent_corridor_clear: bool = False
+    recovery_depth_m: float = 2.0
+    ascent_speed_mps: float = 0.25
+    ascent_acceleration_mps2: float = 0.1
+    ascent_timeout_s: float = 1500.0
+    progress_window_s: float = 30.0
+    minimum_progress_m: float = 1.0
+    maximum_ascent_tilt_deg: float = 25.0
+    fix_max_age_s: float = 2.0
+    fix_max_sigma_m: float = 2.0
+    sensor_loss_confirmation_s: float = 2.0
+
+    def __post_init__(self):
+        if type(self.ascent_corridor_clear) is not bool:
+            raise ValueError("ascent_corridor_clear must be an explicit bool")
+        for name in self.__dataclass_fields__:
+            if name == "ascent_corridor_clear":
+                continue
+            value = getattr(self, name)
+            if not np.isfinite(value) or value <= 0:
+                raise ValueError(f"{name} must be finite and positive")
+        if self.maximum_ascent_tilt_deg >= 35:
+            raise ValueError("ascent permission must be below the 35-degree boundary")
+
+
+@dataclass(frozen=True)
+class ExternalPositionFix:
+    """Trusted receiver-adapter packet in the mission's local NED frame.
+
+    sigma_m is one-axis standard uncertainty, not an authentication guarantee.
+    The caller owns receiver provenance and coordinate-frame conversion.
+    """
+    time_s: float
+    north_east_m: tuple[float, float]
+    sigma_m: float
+    source: str = "acoustic"
+    valid: bool = True
+
+
+class MissionRecoveryManager:
+    def __init__(self, config=None):
+        self.config = config or RecoveryConfig()
+        self.reset()
+
+    def reset(self):
+        self.phase = "inactive"
+        self.reason = "navigation_pause_not_requested"
+        self.pause_start_s = None
+        self.abort_start_s = None
+        self.mission_aborted = False
+        self.ascent_start_s = None
+        self.progress_anchor = None
+        self.last_time_s = None
+        self.last_fix_time_s = None
+        self.fix_chain = []
+        self.fix_status = "none"
+        self.accepted_fix = None
+        self.velocity_trusted_since = None
+        self.sensor_loss_since = None
+        self.relocalization_loss_since = None
+        self.guard_return_phase = None
+
+    def consider_fix(self, packet, *, now_s, estimated_depth_m, depth_trusted):
+        """Return a measurement only after three distinct consistent packets.
+
+        One accepted sequence is not a declaration of recovered velocity or
+        station keeping. A fresh accepted fix plus stable DVL is needed below.
+        """
+        if packet is None:
+            return None
+        if not isinstance(packet, ExternalPositionFix):
+            raise TypeError("external fix must be ExternalPositionFix")
+        xy = np.asarray(packet.north_east_m, dtype=float)
+        valid = (type(packet.valid) is bool and packet.valid and xy.shape == (2,)
+                 and np.all(np.isfinite(xy)) and np.isfinite(packet.time_s)
+                 and np.isfinite(packet.sigma_m)
+                 and 0 < packet.sigma_m <= self.config.fix_max_sigma_m
+                 and 0 <= now_s - packet.time_s <= self.config.fix_max_age_s
+                 and packet.source in ("acoustic", "surface_gnss"))
+        if packet.source == "surface_gnss":
+            # There is no GNSS-underwater assumption or implicit antenna mast.
+            valid = valid and depth_trusted and estimated_depth_m <= 0.0
+        if not valid:
+            self.fix_chain = []
+            self.fix_status = "rejected_invalid_stale_or_submerged"
+            return None
+        if self.last_fix_time_s is not None and packet.time_s <= self.last_fix_time_s:
+            self.fix_status = "rejected_replayed_or_out_of_order"
+            return None
+        self.last_fix_time_s = float(packet.time_s)
+        if self.fix_chain:
+            previous = self.fix_chain[-1]
+            elapsed = packet.time_s - previous.time_s
+            limit = 3.0 * elapsed + 3.0 * np.hypot(packet.sigma_m, previous.sigma_m)
+            if (elapsed > 1.5 or packet.source != previous.source
+                    or np.linalg.norm(xy - previous.north_east_m) > limit):
+                self.fix_chain = []
+        self.fix_chain.append(packet)
+        # Keep the shortest recent history covering the confirmation interval,
+        # not a fixed three-packet slice. Legal cadence jitter can put the last
+        # three packets inside one second even after a valid sequence formed.
+        # Retain at least three distinct observations and the interval boundary.
+        # A resource cap fails closed for excessively dense input; it must not
+        # relax the minimum span or permit single/burst-packet confirmation.
+        self.fix_chain = self.fix_chain[-256:]
+        while (len(self.fix_chain) > 3
+               and packet.time_s - self.fix_chain[1].time_s + 1e-9 >= 1.0):
+            self.fix_chain.pop(0)
+        if len(self.fix_chain) < 3 or packet.time_s - self.fix_chain[0].time_s + 1e-9 < 1.0:
+            self.fix_status = "confirming"
+            return None
+        self.accepted_fix = packet
+        self.fix_status = "accepted_external_measurement"
+        return packet
+
+    def update(self, *, now_s, navigation_latched, state, sources, decision):
+        if not np.isfinite(now_s) or (self.last_time_s is not None and now_s < self.last_time_s):
+            raise ValueError("recovery time must be finite and nondecreasing")
+        self.last_time_s = now_s
+        if not navigation_latched and self.phase == "inactive":
+            return self.phase
+        if self.phase == "inactive":
+            self.phase = "pause"
+            self.pause_start_s = now_s
+            self.reason = "finite_navigation_pause"
+        if sources.get("linear_velocity") == "dvl":
+            if self.velocity_trusted_since is None:
+                self.velocity_trusted_since = now_s
+        else:
+            self.velocity_trusted_since = None
+        # A fix never releases the supervisor's mission latch. Terminate the old
+        # mission even if localization is restored during the pause.
+        recovered = (self.accepted_fix is not None
+                     and 0 <= now_s - self.accepted_fix.time_s <= self.config.fix_max_age_s
+                     and self.velocity_trusted_since is not None
+                     and now_s - self.velocity_trusted_since >= 2.0
+                     and sources.get("attitude") == "imu"
+                     and sources.get("angular_velocity") == "imu"
+                     and sources.get("depth") == "depth_sensor")
+        if recovered and self.phase not in ("abort_external_recovery",):
+            self.phase = "relocalized_wait"
+            self.reason = "external_fix_and_stable_velocity_new_mission_authorization_required"
+            self._abort(now_s)
+        if self.phase == "relocalized_wait":
+            # Position re-anchoring is an event, not perpetual nav health.
+            if (sources.get("linear_velocity") != "dvl"
+                    or sources.get("attitude") != "imu"
+                    or sources.get("angular_velocity") != "imu"
