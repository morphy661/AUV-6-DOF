+"""Low-bandwidth abort-only XY hold using accepted external measurements.
+
+No plant truth, IMU-integrated velocity or mission route is used. This is an
+optional receiver-dependent capability, not navigation recovery. A common
+receiver bias is unobservable here; the adapter must own frame and provenance.
+"""
+from dataclasses import dataclass
+import numpy as np
+
+
+@dataclass(frozen=True)
+class ExternalHoldConfig:
+    window_s: float = 6.0
+    minimum_span_s: float = 4.0
+    max_age_s: float = 1.0
+    max_gap_s: float = 1.0
+    max_sigma_m: float = 1.0
+    max_speed_mps: float = 0.6
+    max_velocity_sigma_mps: float = 0.15
+    position_gain_npm: float = 1.5
+    velocity_gain_nspm: float = 20.0
+    integral_gain_npm_s: float = 0.15
+    max_integral_force_n: float = 4.0
+    max_force_n: float = 8.0
+    slew_nps: float = 2.0
+    maximum_tilt_deg: float = 20.0
+
+    def __post_init__(self):
+        for name in self.__dataclass_fields__:
+            if not np.isfinite(getattr(self, name)) or getattr(self, name) <= 0:
+                raise ValueError(name + ' must be finite and positive')
+        if self.minimum_span_s > self.window_s or self.maximum_tilt_deg >= 35:
+            raise ValueError('invalid observation window or tilt boundary')
+
+
+def limited(vector, maximum):
+    norm = float(np.linalg.norm(vector))
+    return vector * min(1., maximum / max(norm, 1e-12))
+
+
+class ExternalPositionHold:
+    def __init__(self, config=None):
+        self.config = config or ExternalHoldConfig()
+        self.reset()
+
+    def reset(self):
+        self.packets = []
+        self.anchor = None
+        self.force = np.zeros(2)
+        self.integral_force = np.zeros(2)
+        self.fit = None
+        self.reason = 'inactive'
+        self.last_update = None
+
+    def reject(self):
+        # Withdraw with force slew on the next update, never carry a stale fit.
+        self.packets = []
+        self.fit = None
+        self.anchor = None
+        self.integral_force[:] = 0.
+        self.reason = 'receiver_rejected'
+
+    def observe(self, packet):
+        cfg = self.config
+        xy = np.asarray(packet.north_east_m, dtype=float)
+        if (not packet.valid or xy.shape != (2,) or not np.all(np.isfinite(xy))
+                or not np.isfinite(packet.time_s) or not np.isfinite(packet.sigma_m)
+                or not 0 < packet.sigma_m <= cfg.max_sigma_m):
+            self.reject(); return
+        if self.packets:
+            previous = self.packets[-1]
+            gap = packet.time_s - previous.time_s
+            if gap <= 0:
+                self.reject(); return
+            if gap > cfg.max_gap_s + 1e-8 or packet.source != previous.source:
+                self.reject()
+        self.packets.append(packet)
+        self.packets = [p for p in self.packets if packet.time_s-p.time_s <= cfg.window_s+1e-8]
+        self.fit = None
+        if len(self.packets) < 5 or packet.time_s-self.packets[0].time_s < cfg.minimum_span_s-1e-8:
+            self.reason = 'confirming_external_motion'; return
+        times = np.array([p.time_s-packet.time_s for p in self.packets])
+        xy = np.array([p.north_east_m for p in self.packets])
+        sigma = np.array([p.sigma_m for p in self.packets])
+        design = np.column_stack((np.ones(len(times)), times))
+        weighted = design / sigma[:, None]
+        coeff = np.linalg.lstsq(weighted, xy/sigma[:,None], rcond=None)[0]
+        residual = (xy - design @ coeff) / sigma[:,None]
+        velocity_sigma = float(np.sqrt(np.linalg.inv(weighted.T @ weighted)[1,1]))
+        if (np.max(np.abs(residual)) > 4.0 or np.sqrt(np.mean(residual**2)) > 2.0
+                or np.linalg.norm(coeff[1]) > cfg.max_speed_mps):
+            self.reject(); self.reason = 'external_motion_inconsistent'; return
+        if velocity_sigma > cfg.max_velocity_sigma_mps:
+            # Insufficient precision is not an invalid packet. Keep the bounded
+            # history to accumulate a longer span; no force from this fit yet.
+            self.reason = 'confirming_external_precision'; return
+        self.fit = (packet.time_s, coeff[0], coeff[1], velocity_sigma)
+        self.reason = 'external_motion_ready'
+
+    def update(self, *, now_s, dt, permitted, hard_guard=False):
+        if (not np.isfinite(now_s) or not np.isfinite(dt) or dt <= 0
+                or (self.last_update is not None and now_s < self.last_update)):
+            raise ValueError('time must be finite, monotonic; dt must be positive')
+        self.last_update = now_s
+        desired = np.zeros(2)
+        active = False
+        position = velocity = None
+        if not permitted or hard_guard:
+            # Keep a still-observed abort reference across brief sensor guards;
+            # do not turn each guard into a new downstream station-keeping point.
+            if self.fit is None or not 0 <= now_s-self.fit[0] <= self.config.max_age_s:
+                self.anchor = None
+            self.integral_force[:] = 0.
+            self.reason = 'control_guard' if hard_guard else 'not_in_degraded_abort'
+        elif self.fit is not None:
+            time, point, speed, sigma = self.fit
+            if 0 <= now_s-time <= self.config.max_age_s+1e-8:
+                position = point + speed*(now_s-time)
+                velocity = speed
+                if self.anchor is None:
+                    # Anchor at the start of the confirmed observation window,
+                    # fitted from those same past measurements, not old route/DR.
+                    self.anchor = point + speed*(self.packets[0].time_s-time)
+                error = self.anchor-position
+                pd = self.config.position_gain_npm*error - self.config.velocity_gain_nspm*speed
+                proposed = limited(self.integral_force+self.config.integral_gain_npm_s*error*dt,
+                                   self.config.max_integral_force_n)
+                # Conditional integration prevents accumulation into saturation.
+                if (np.linalg.norm(pd+proposed) <= self.config.max_force_n
+                        or np.linalg.norm(pd+proposed) < np.linalg.norm(pd+self.integral_force)):
+                    self.integral_force = proposed
+                desired = limited(pd+self.integral_force, self.config.max_force_n)
+                active = True
+                self.reason = 'external_position_limited_hold'
+            else:
+                self.reject(); self.reason = 'external_position_stale'
+        # Loss of depth/attitude authority disables immediately. Ordinary link
+        # loss fades to zero in at most max_force/slew seconds. Integral bias is
+        # cleared on link loss/receiver rejection; it never survives a new anchor.
+        if hard_guard or not permitted:
+            self.force[:] = 0.
+        else:
+            self.force += limited(desired-self.force, self.config.slew_nps*dt)
+        return dict(active=active, reason=self.reason,
+                    force_ned_n=self.force.copy(),
+                    integral_force_n=self.integral_force.copy(),
+                    anchor_ne_m=None if self.anchor is None else self.anchor.copy(),
+                    position_ne_m=None if position is None else position.copy(),
+                    velocity_ne_mps=None if velocity is None else velocity.copy(),
+                    sample_count=len(self.packets),
+                    fix_age_s=None if not self.packets else now_s-self.packets[-1].time_s)
